# Deny direct execution of scripts inside uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|phar|inc|pl|py|cgi|sh|bash|exe)$">
    Require all denied
</FilesMatch>

# Allow public reading of images
<FilesMatch "(?i)\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Require all granted
</FilesMatch>

