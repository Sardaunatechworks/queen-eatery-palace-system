# Queen Eatery Palace - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to Git

# Database
DB_HOST=localhost
DB_NAME=queen_eatery
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_PORT=3306

# JWT
JWT_SECRET=CHANGE_THIS_generate_a_64_char_random_string_using_openssl_rand_hex_32

# Paystack
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# SMTP Mail
SMTP_HOST=mail.queenspalaceeatery.com
SMTP_PORT=587
SMTP_USERNAME=noreply@queenspalaceeatery.com
SMTP_PASSWORD=your_smtp_password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=noreply@queenspalaceeatery.com
SMTP_FROM_NAME=Queen's Palace Eatery

# Application
APP_URL=https://queenspalaceeatery.com
API_URL=https://queenspalaceeatery.com/api
APP_ENV=production
APP_DEBUG=false
